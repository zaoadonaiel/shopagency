# Copy to .env for `npm start` / `npm test`. On Cloudflare, set the same names with
# `npx wrangler secret put NAME` (secrets) or in wrangler.jsonc "vars" (non-secret settings).
# Never commit real keys.

# Public address of the shop (used in emails, Stripe redirects and Supabase email links)
APP_URL=https://shop.theagencyschool.com
PORT=3000

# Supabase: Project Settings > API. The service role key bypasses row level security:
# keep it on the server only (a .env file or a Cloudflare secret), never in browser code.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Leave STRIPE_SECRET_KEY empty for dev mode (a fake "pay" button is used instead).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# In Stripe, add a webhook to APP_URL/webhooks/stripe for the event: checkout.session.completed

# Email sent by the shop (job alerts, reminders, receipts). Leave SMTP_HOST empty in dev and emails
# print to the console instead. On Cloudflare Workers use port 587 with SMTP_SECURE=false (port 465 is blocked).
# Invite and password-reset emails are sent by Supabase: put the same SMTP in Supabase > Auth > SMTP Settings.
MAIL_FROM=The Agency School <info@theagencyschool.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# WordPress provisioning on the owner's hosting (see src/provision.js). All empty = fake dev values.
# On a Node server: shell commands.
PROVISION_CMD=
LOGIN_LINK_CMD=
STAGING_DOMAIN=
# On Cloudflare Workers: HTTPS endpoints on the hosting box (see scripts/provision-server.example.js).
PROVISION_URL=
LOGIN_LINK_URL=
PROVISION_TOKEN=

# Timing rules
UNCLAIMED_ALERT_HOURS=2
AUTO_APPROVE_HOURS=48
